APP_NAME=PAxMEDIA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# PostgreSQL Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=paxmedia
DB_USERNAME=paxmedia
DB_PASSWORD=paxmedia_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cache & Session
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@paxmedia.com"
MAIL_FROM_NAME="${APP_NAME}"
