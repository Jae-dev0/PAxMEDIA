# ==============================================================================
# PAxMEDIA - environment template.
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# This is the ONLY .env in the project. There is deliberately no backend/.env:
# the Laravel app runs inside Docker and receives everything from this file via
# `env_file` in docker-compose.yml. Two .env files risk shadowing, where a
# stale backend/.env silently overrides the real configuration.
#
# Generate a key with:
#   docker compose run --rm backend php artisan key:generate --show
# ==============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=PAxMEDIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Database ----------------------------------------------------------------
# DB_HOST is the Docker service name. The port is also published to the host,
# so Navicat connects via localhost:5432 with these same credentials.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=paxmedia
DB_USERNAME=paxmedia
DB_PASSWORD=

# --- Redis (cache, session, queue) -------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

# NOTE: Laravel 11+ reads CACHE_STORE, not the old CACHE_DRIVER. Setting
# CACHE_DRIVER is silently ignored and leaves the cache pointing at a `cache`
# table that this project does not have.
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- Sanctum -----------------------------------------------------------------
# This app uses Bearer tokens, not cookie sessions, so no stateful domains
# are required. Leave empty.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

# --- CORS --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# --- Frontend ----------------------------------------------------------------
# Baked into the bundle at build time, because Vite inlines VITE_* variables.
VITE_API_URL=http://localhost:8000/api
