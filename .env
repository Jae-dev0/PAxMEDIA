# ==============================================================================
# PAxMEDIA - single source of truth for all environment configuration.
#
# This is the ONLY .env in the project. There is deliberately no backend/.env:
# the Laravel app runs inside Docker and receives everything from here via
# `env_file` in docker-compose.yml. Keeping one file avoids the two-.env
# shadowing problem, where a stale backend/.env can silently override the
# real configuration.
#
# Copy to .env.example and fill in real values for other machines.
# ==============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=PAxMEDIA
APP_ENV=local
APP_KEY=base64:mo1xXOrsyICmImFgimUiw21QClPIV0ysjmVwwI202Qw=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ─── Database (host/port/creds) ───────────────────────────────────────────────
# DB_HOST is the Docker service name. The database port is also published to
# the host so Navicat can connect via localhost:5432.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=paxmedia
DB_USERNAME=paxmedia
DB_PASSWORD=paxmedia_secret

# ─── Redis (cache, session, queue) ───────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

# NOTE: Laravel 11+ reads CACHE_STORE, not the old CACHE_DRIVER. Setting
# CACHE_DRIVER is silently ignored and leaves the cache pointing at a
# `cache` table that this project does not have.
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ─── Sanctum ─────────────────────────────────────────────────────────────────
# Bearer-token auth, so no stateful cookie domains are required.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ─── Frontend ────────────────────────────────────────────────────────────────
# Baked into the bundle at build time (Vite inlines VITE_* vars).
VITE_API_URL=http://localhost:8000/api
